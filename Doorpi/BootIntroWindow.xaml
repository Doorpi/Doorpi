<Window x:Class="Doorpi.BootIntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="#020309"
        AllowsTransparency="False" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DDE7FA"/>
            <Setter Property="Background" Value="#121E34"/>
            <Setter Property="BorderBrush" Value="#354763"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="30,17"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#263B59"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#DBE8FA"/>
                                <Setter Property="Foreground" Value="#09111E"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="#020309">
        <!-- A quiet prelude, never a second logo animation or another soundtrack. -->
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas Width="1280" Height="720" ClipToBounds="True">
                <Ellipse Width="1440" Height="700" Canvas.Left="-80" Canvas.Top="225" Opacity="0.8">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.65" GradientOrigin="0.5,0.65" RadiusX="0.55" RadiusY="0.6">
                            <GradientStop Color="#163467" Offset="0"/>
                            <GradientStop Color="#0B1633" Offset="0.43"/>
                            <GradientStop Color="#00020309" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="AmbientLight" Width="1100" Height="250" Canvas.Left="90" Canvas.Top="465" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4872B4" Offset="0"/>
                            <GradientStop Color="#1B355E" Offset="0.3"/>
                            <GradientStop Color="#00020309" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M -150,735 Q 640,415 1430,735" StrokeThickness="1" Opacity="0.55">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#002C4677" Offset="0"/>
                            <GradientStop Color="#7397CB" Offset="0.5"/>
                            <GradientStop Color="#002C4677" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Canvas>
        </Viewbox>
        <Viewbox Stretch="Uniform" Margin="24">
            <Grid Width="1232" Height="672">
                <Grid x:Name="StatusPanel" Width="560" Height="128" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,68">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Row="0" Text="Iniciando" Foreground="#C7D7EE" FontFamily="Segoe UI"
                               FontSize="17" FontWeight="Light" TextAlignment="Center"/>
                    <TextBlock x:Name="SubtitleText" Grid.Row="1" Text="" Foreground="#7F96B7" FontSize="13" TextAlignment="Center"/>
                    <Border x:Name="BreathingLine" Grid.Row="2" Width="64" Height="1" Background="#93B6EC" Opacity="0.6"/>
                </Grid>
                <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="RecoveryTitle" Text="Não conseguimos continuar." Foreground="#ECF3FF"
                               FontSize="30" FontWeight="Light" TextAlignment="Center"/>
                    <TextBlock x:Name="RecoveryCopy" Text="Tente novamente ou abra a área de trabalho." Foreground="#99ACC7"
                               FontSize="16" TextAlignment="Center" Margin="0,18,0,36"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="RetryButton" Content="Tentar novamente" IsDefault="True" Click="RetryClick"/>
                        <Button x:Name="DesktopButton" Content="Área de trabalho" Click="DesktopClick"/>
                    </StackPanel>
                    <TextBlock x:Name="RecoveryHint" Text="A / Enter · confirmar     B / Esc · área de trabalho"
                               Foreground="#7286A3" FontSize="12" TextAlignment="Center" Margin="0,26,0,0"/>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

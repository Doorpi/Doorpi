<Window x:Class="Doorpi.BootIntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#020309"
        AllowsTransparency="False">
    <Grid x:Name="Root" ClipToBounds="True" Opacity="1">
        <Grid.Background>
            <SolidColorBrush Color="#030611" />
        </Grid.Background>

        <Canvas x:Name="UniverseLayer" Opacity="0" IsHitTestVisible="False">
            <Ellipse Width="1240" Height="1240" Canvas.Left="-360" Canvas.Top="-520"
                     Stroke="#182F62" StrokeThickness="1" Opacity="0.32"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="ConstellationOuterRotate" Angle="0" CenterX="620" CenterY="620" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="920" Height="920" Canvas.Left="-210" Canvas.Top="-360"
                     Stroke="#12254E" StrokeThickness="1" Opacity="0.22"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="ConstellationInnerRotate" Angle="0" CenterX="460" CenterY="460" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Canvas Width="1240" Height="1240" Canvas.Left="-360" Canvas.Top="-520" Opacity="0.68">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-620" Y="-620" />
                        <RotateTransform x:Name="ConstellationOuterDotsRotate" Angle="0" />
                        <TranslateTransform X="620" Y="620" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse Width="5.2" Height="5.2" Fill="#6CA5FF" Canvas.Left="905" Canvas.Top="255" Opacity="0.74" />
                <Ellipse Width="3.6" Height="3.6" Fill="#CDE4FF" Canvas.Left="1112" Canvas.Top="610" Opacity="0.56" />
                <Ellipse Width="4.2" Height="4.2" Fill="#8FB7FF" Canvas.Left="718" Canvas.Top="104" Opacity="0.6" />
            </Canvas>
            <Canvas Width="920" Height="920" Canvas.Left="-210" Canvas.Top="-360" Opacity="0.62">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-460" Y="-460" />
                        <RotateTransform x:Name="ConstellationInnerDotsRotate" Angle="0" />
                        <TranslateTransform X="460" Y="460" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse Width="4.8" Height="4.8" Fill="#CDE4FF" Canvas.Left="635" Canvas.Top="186" Opacity="0.68" />
                <Ellipse Width="3.2" Height="3.2" Fill="#FFFFFF" Canvas.Left="808" Canvas.Top="452" Opacity="0.48" />
                <Ellipse Width="4" Height="4" Fill="#6CA5FF" Canvas.Left="390" Canvas.Top="70" Opacity="0.56" />
            </Canvas>
            <Ellipse Width="880" Height="620" Canvas.Left="900" Canvas.Top="590" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#23366FFF" Offset="0" />
                        <GradientStop Color="#00010208" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="ConstellationStarA" Width="2" Height="2" Fill="#CDE4FF" Canvas.Left="310" Canvas.Top="170" Opacity="0.58" />
            <Ellipse x:Name="ConstellationStarB" Width="1.4" Height="1.4" Fill="#FFFFFF" Canvas.Left="530" Canvas.Top="258" Opacity="0.42" />
            <Ellipse Width="2.2" Height="2.2" Fill="#6CA5FF" Canvas.Left="1190" Canvas.Top="210" Opacity="0.46" />
            <Ellipse Width="1.6" Height="1.6" Fill="#DCEBFF" Canvas.Left="1430" Canvas.Top="446" Opacity="0.32" />
            <Ellipse Width="2" Height="2" Fill="#FFFFFF" Canvas.Left="885" Canvas.Top="126" Opacity="0.48" />
            <Ellipse Width="1.6" Height="1.6" Fill="#8FB7FF" Canvas.Left="708" Canvas.Top="730" Opacity="0.36" />
            <Ellipse Width="1.8" Height="1.8" Fill="#DCEBFF" Canvas.Left="1510" Canvas.Top="782" Opacity="0.34" />
        </Canvas>

        <Grid x:Name="LogoStage" HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="900" Height="700" Opacity="0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="StageScale" ScaleX="0.94" ScaleY="0.94" CenterX="450" CenterY="350" />
                    <TranslateTransform x:Name="StageTranslate" Y="18" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse x:Name="BackHalo" Width="790" Height="520" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,-60,0,0" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#622760F2" Offset="0" />
                        <GradientStop Color="#20204CB8" Offset="0.4" />
                        <GradientStop Color="#00010208" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="GroundLight" Width="440" Height="64" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,300,0,0" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#466CA5FF" Offset="0" />
                        <GradientStop Color="#15285FBE" Offset="0.45" />
                        <GradientStop Color="#00030611" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="16" />
                </Ellipse.Effect>
            </Ellipse>

            <Grid Width="720" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="0,-78,0,0" Opacity="0.0" x:Name="OrbitArcLayer">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="OrbitArcRotate" Angle="-8" CenterX="360" CenterY="250" />
                </Grid.RenderTransform>
                <Path Stroke="#335F95D8" StrokeThickness="1.4" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeDashArray="360 520"
                      Data="M 86,290 C 202,122 522,74 648,260 C 560,388 266,410 110,310">
                    <Path.Effect>
                        <DropShadowEffect Color="#365FA8" BlurRadius="8" ShadowDepth="0" Opacity="0.36" />
                    </Path.Effect>
                </Path>
            </Grid>

            <Ellipse x:Name="CoreBloom" Width="360" Height="430" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,-58,0,0" Opacity="0">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CoreBloomScale" ScaleX="0.12" ScaleY="0.12" CenterX="180" CenterY="215" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#E9F5FFFF" Offset="0" />
                        <GradientStop Color="#9C6CA5FF" Offset="0.24" />
                        <GradientStop Color="#2B2563EB" Offset="0.54" />
                        <GradientStop Color="#00020309" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="14" />
                </Ellipse.Effect>
            </Ellipse>

            <Viewbox Width="640" Height="530" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="0,-94,0,0">
                <Grid x:Name="LogoPathLayer" Width="357" Height="302">
                    <Path x:Name="LogoTrace"
                          Stretch="Uniform"
                          Fill="Transparent"
                          Opacity="0"
                          StrokeThickness="1.65"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeDashArray="2600 2600"
                          StrokeDashOffset="2600"
                          Data="M491.466248,448.851471 C491.608276,430.705597 491.779083,413.042450 491.876709,395.378906 C491.981354,376.446472 508.188202,366.194916 525.097473,374.768524 C545.386963,385.055969 565.459961,395.770844 585.616089,406.320831 C594.313293,410.873047 602.936646,415.568481 611.678162,420.033142 C623.370544,426.004913 629.275146,435.542358 629.111328,448.569122 C628.545471,493.556702 627.830200,538.542419 627.159241,583.528687 C626.903259,600.689453 626.754395,617.853821 626.241333,635.007141 C626.110962,639.366943 627.244263,641.305237 631.672974,642.608398 C657.675049,650.259399 683.562744,658.299133 709.485840,666.218262 C710.266846,666.456848 711.013245,666.808777 713.093750,667.624756 C675.661926,667.624756 639.601135,667.624756 602.966492,667.624756 C602.966492,665.443115 602.941467,663.498840 602.970093,661.555298 C603.971924,593.576843 604.936218,525.597778 606.029602,457.620758 C606.198303,447.128326 601.579468,439.620483 592.603638,434.901001 C578.896790,427.694000 565.018494,420.808441 551.135925,413.942352 C543.803528,410.315796 539.581421,412.998871 539.488892,421.233521 C538.822205,480.550201 538.205566,539.867432 537.564026,599.184387 C537.333740,620.477661 536.995544,641.770325 536.914490,663.064087 C536.900513,666.735291 535.945618,667.921204 532.135193,667.910828 C475.811768,667.757141 419.487885,667.758850 363.164154,667.699768 C361.375824,667.697876 359.587738,667.440491 357.704132,666.710815 C365.264282,664.606689 372.823639,662.499756 380.384735,660.398987 C415.153320,650.738831 449.908630,641.030273 484.712067,631.497314 C488.290710,630.517151 489.743225,629.202698 489.761627,625.199585 C489.976105,578.551147 490.385681,531.903442 490.805603,485.256104 C490.913391,473.281097 491.237885,461.308014 491.466248,448.851471 z">
                        <Path.Stroke>
                            <SolidColorBrush Color="#607B9F" />
                        </Path.Stroke>
                        <Path.Effect>
                            <DropShadowEffect Color="#325E9A" BlurRadius="5" ShadowDepth="0" Opacity="0.32" />
                        </Path.Effect>
                    </Path>
                </Grid>
            </Viewbox>

            <StackPanel x:Name="BrandStack" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,14" Opacity="0">
                <Border Width="72" Height="1" Background="#455F82A0" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="Doorpi" HorizontalAlignment="Center"
                           Foreground="#7889A3" FontSize="30" FontWeight="Light" />
            </StackPanel>
        </Grid>

        <Canvas x:Name="DropletCanvas" Opacity="0" IsHitTestVisible="False" />

        <StackPanel x:Name="PreparingPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,68" Orientation="Horizontal" Opacity="0">
            <Grid Width="22" Height="22" Margin="0,0,12,0">
                <Ellipse Stroke="#22FFFFFF" StrokeThickness="2" />
                <Path Stroke="#DFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round"
                      Data="M 11,2 A 9,9 0 0 1 20,11">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="11" CenterY="11" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock Text="Preparando sistema" Foreground="#CCFFFFFF" FontSize="15" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>

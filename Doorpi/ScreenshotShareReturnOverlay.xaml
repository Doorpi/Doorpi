<Window x:Class="Doorpi.ScreenshotShareReturnOverlay" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="312" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" FontFamily="Segoe UI">
    <Border Margin="8" Padding="16,14" CornerRadius="10"
            Background="#EE111722" BorderBrush="#5D9BB9E8" BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.48" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Foreground="#F5F8FF"/>
            <TextBlock x:Name="Hint" Margin="0,5,0,13" FontSize="12" TextWrapping="Wrap" Foreground="#BFCBE0"/>
            <Button x:Name="ReturnButton" Click="ReturnClick" Padding="14,10"
                    HorizontalAlignment="Stretch" Background="#2A4265" Foreground="#F7FAFF"
                    BorderBrush="#8BB7EA" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3B5D8D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1C304E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="ReturnLabel" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
